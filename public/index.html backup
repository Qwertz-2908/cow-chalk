<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#00343d">
<title id="pageTitle">Cow Chalk Timer</title>
<link rel="icon" href="https://raw.githubusercontent.com/MrMoo-213/cow-chalk/main/assets/pictures/favicon1.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pirata+One&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
/* --u = one "design pixel". The page is drawn on a 1200 x 800 grid and
   scaled to fit the window, so proportions stay identical at any size. */
:root{color-scheme:dark;--bg:#00343d;--cyan:#68c8d8;--u:min(calc(100vw / 1200),calc(100vh / 850))}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{background:var(--bg);font-family:Arial,Helvetica,sans-serif;color:#fff;overflow-x:hidden}
button{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
.page{min-height:100vh;display:flex;flex-direction:column;align-items:center;padding-bottom:calc(30*var(--u))}

/* ---------- sound options ---------- */
.sounds{margin-top:calc(30*var(--u));width:min(calc(1125*var(--u)),94vw);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center;justify-items:start;gap:calc(12*var(--u)) calc(18*var(--u))}
.opt{position:relative;display:flex;align-items:center;gap:calc(10*var(--u));font-size:calc(19*var(--u));font-weight:700;white-space:nowrap;cursor:pointer;min-width:0}
.opt.hidden-sound{display:none}
.show-more{display:flex;align-items:center;justify-content:center;gap:calc(12*var(--u));min-height:calc(36*var(--u));padding:0;border:0;background:none;color:#fff;font:700 calc(19*var(--u)) Arial,Helvetica,sans-serif;cursor:pointer;white-space:nowrap}
.show-more:focus-visible{outline:calc(3*var(--u)) solid #fff;outline-offset:calc(3*var(--u))}
@media(max-width:700px){.sounds{grid-template-columns:repeat(2,minmax(0,1fr))}.opt{font-size:calc(18*var(--u))}}
.opt input{position:absolute;opacity:0;pointer-events:none}
.dot{position:relative;flex:none;width:calc(36*var(--u));height:calc(36*var(--u));border-radius:50%;border:calc(1.5*var(--u)) solid #0a8a97;
  background:radial-gradient(circle at 35% 30%,#46d3de 0 12%,#1aa3b0 36%,#087a87 70%,#056571 100%);
  box-shadow:inset calc(2*var(--u)) calc(2*var(--u)) calc(5*var(--u)) #7fe3ea88,0 0 calc(2*var(--u)) #71dce7}
.dot:after{content:"";position:absolute;inset:25%;border-radius:50%;background:#04424c;box-shadow:inset 0 calc(2*var(--u)) calc(3*var(--u)) #0009}
.opt input:checked+.dot:after{background:#aef3f6;box-shadow:0 0 calc(9*var(--u)) #7ff0f6}
.opt input:focus-visible+.dot{outline:calc(3*var(--u)) solid #fff;outline-offset:calc(3*var(--u))}
.stopwatch-on .sounds{visibility:hidden}

/* ---------- display ---------- */
.timer-wrap{position:relative;margin-top:calc(145*var(--u));width:calc(1125*var(--u))}
.display{--bw:calc(14*var(--u));--vp:calc(12*var(--u));
  display:flex;align-items:stretch;height:calc(220*var(--u));padding:var(--vp) calc(16*var(--u));
  background:#000;border:var(--bw) solid var(--cyan);border-radius:calc(42*var(--u))}
.unit{position:relative;flex:none;display:flex;width:calc(103*var(--u))}
.unit.wide{width:calc(206*var(--u))}
.digit{flex:1 1 0;min-width:0;display:flex;align-items:center;justify-content:center}
.digit svg{display:block;flex:none;width:calc(96.6*var(--u));height:calc(158*var(--u));overflow:visible;filter:drop-shadow(calc(-6*var(--u)) calc(7*var(--u)) 0 #707070)}
.segment{fill:transparent;stroke:none}
.segment.on{fill:#67c8d8}

.separator{flex:none;width:calc(80*var(--u));display:flex;flex-direction:column;justify-content:center;align-items:center;gap:calc(18*var(--u))}
.separator i{display:block;flex:none;width:calc(46*var(--u));height:calc(46*var(--u));border-radius:50%;background:var(--cyan);box-shadow:calc(-7*var(--u)) calc(8*var(--u)) 0 #707070}
.separator.decimal{justify-content:flex-end}
.separator.decimal i{width:calc(44*var(--u));height:calc(44*var(--u))}

/* ---------- arrows ---------- */
.arrow{position:absolute;left:50%;width:calc(76*var(--u));height:calc(76*var(--u));padding:0;border:0;background:none}
.arrow svg{display:block;width:100%;height:100%;filter:drop-shadow(calc(2*var(--u)) calc(3*var(--u)) 0 #0007)}
.arrow.up{bottom:calc(100% + var(--vp) + var(--bw) + 8*var(--u));transform:translateX(-50%)}
.arrow.down{top:calc(100% + var(--vp) + var(--bw) + 10*var(--u));transform:translateX(-50%) rotate(180deg)}
.arrow:active svg{filter:brightness(.7) drop-shadow(calc(1*var(--u)) calc(1*var(--u)) 0 #0007)}
.stopwatch-on .arrow{visibility:hidden}

/* ---------- controls ---------- */
.controls{display:flex;gap:calc(67*var(--u));margin-top:calc(115*var(--u))}
.ctl{width:calc(100*var(--u));height:calc(100*var(--u));border:0;border-radius:calc(5*var(--u));background:#fff;display:grid;place-items:center;
  box-shadow:calc(2*var(--u)) calc(3*var(--u)) calc(4*var(--u)) #0008}
.ctl svg{width:52%;height:52%;display:block}
.ctl:active{transform:translateY(calc(2*var(--u)));box-shadow:none}
.ctl:focus-visible,.mode:focus-visible,.arrow:focus-visible{outline:calc(3*var(--u)) solid #fff;outline-offset:calc(3*var(--u))}

/* ---------- stopwatch / timer switch ---------- */
.mode{margin-top:calc(26*var(--u));width:calc(285*var(--u));height:calc(52*var(--u));border:calc(3*var(--u)) solid #c42c68;border-radius:calc(7*var(--u));
  background:linear-gradient(#ff82b8 0,#ff4f91 48%,#ff3c82 100%);color:#fff;font-size:calc(26*var(--u));font-weight:900;font-style:italic;letter-spacing:calc(1*var(--u));
  text-shadow:0 calc(1*var(--u)) calc(2*var(--u)) #b51b5a;box-shadow:inset 0 calc(3*var(--u)) 0 #ffffff55,0 calc(2*var(--u)) calc(3*var(--u)) #0008}
.mode:active{transform:translateY(calc(2*var(--u)))}


.menu-overlay{position:fixed;inset:0;z-index:20;background:#00343d;display:flex;align-items:center;justify-content:center;padding:24px}
.menu-overlay[hidden]{display:none}
.menu-panel{width:min(420px,92vw);display:grid;gap:calc(18*var(--u))}
.menu-title{font-size:clamp(30px,5vw,48px);font-weight:900;text-align:center;margin:0 0 12px}
.menu-option{width:100%;min-height:calc(60*var(--u));border:calc(3*var(--u)) solid #c42c68;border-radius:calc(7*var(--u));background:linear-gradient(#ff82b8 0,#ff4f91 48%,#ff3c82 100%);color:#fff;font-size:clamp(19px,3vw,26px);font-weight:900;font-style:italic;letter-spacing:calc(1*var(--u));text-shadow:0 calc(1*var(--u)) calc(2*var(--u)) #b51b5a;box-shadow:inset 0 calc(3*var(--u)) 0 #ffffff55,0 calc(2*var(--u)) calc(3*var(--u)) #0008}
.menu-option:active{transform:translateY(2px)}
.menu-option:focus-visible{outline:3px solid #fff;outline-offset:3px}
body.realtime-on .sounds,body.realtime-on .controls,body.realtime-on .arrow{display:none}
body.realtime-on .timer-wrap{margin-top:auto;margin-bottom:auto}
#realDate{display:none;text-align:center;font-size:calc(32*var(--u));font-weight:800;margin-bottom:calc(24*var(--u));color:#fff}
body.realtime-on #realDate{display:block}
body.realtime-on .timer-wrap{display:flex;flex-direction:column;align-items:center}


/* ---------- Pirate Game Intro ---------- */
#pirateGame{background:#0a1118}
.pirate-intro{position:absolute;inset:0;z-index:30;display:none;overflow:hidden;align-items:center;justify-content:center;background:#0a1118;color:#eee;font-family:"Share Tech Mono",monospace;perspective:1000px}
#pirateGame.pirate-intro-active .pirate-intro{display:flex}
#pirateGame.pirate-intro-active .pirate-layout{display:none}
.pirate-ambient{position:absolute;inset:0;z-index:1;background:radial-gradient(circle at 50% 50%,rgba(26,47,68,.4),#0a1118 80%),linear-gradient(0deg,rgba(139,0,0,.15),transparent);animation:pirateOceanPulse 8s ease-in-out infinite alternate}
.pirate-grid-backdrop{position:absolute;top:50%;left:50%;width:700px;height:700px;opacity:.12;z-index:2;display:grid;grid-template-columns:repeat(7,1fr);grid-template-rows:repeat(7,1fr);border:2px solid #4a6984;background:transparent;transform:translate(-50%,-50%) rotateX(65deg) rotateZ(0deg) translateZ(-100px);animation:pirateGridFloat 20s linear infinite;pointer-events:none}
.pirate-grid-backdrop .pirate-grid-cell{position:relative;border:1px dashed #4a6984;background:transparent}
.pirate-floats{position:absolute;inset:0;width:100%;height:100%;z-index:3;pointer-events:none;overflow:hidden}
.pirate-floats span{position:absolute;color:#4a6984;font-size:2rem;font-weight:bold;opacity:0;animation:pirateSymbolFly 12s infinite linear}
.pirate-floats span:nth-child(1){top:20%;left:10%;animation-delay:0s}
.pirate-floats span:nth-child(2){top:70%;left:15%;animation-delay:3s;color:#ffd700;font-size:3rem}
.pirate-floats span:nth-child(3){top:40%;left:80%;animation-delay:1.5s}
.pirate-floats span:nth-child(4){top:80%;left:75%;animation-delay:4.5s}
.pirate-floats span:nth-child(5){top:15%;left:60%;animation-delay:6s}
.pirate-intro-content{position:relative;z-index:10;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;max-width:800px;padding:20px;max-height:100%;overflow:visible}
.pirate-credits{font-size:.9rem;text-transform:uppercase;letter-spacing:4px;color:#4a6984;opacity:0;transform:translateY(-20px);animation:pirateFadeDown 1s .5s cubic-bezier(.19,1,.22,1) forwards;margin-bottom:10px}
.pirate-credits span{color:#ffd700;text-shadow:0 0 10px rgba(255,215,0,.3)}
.pirate-intro-title-wrap{position:relative;margin-bottom:40px}
.pirate-intro-title{font-family:"Pirata One",cursive;font-size:6.5rem;color:#eee;text-transform:uppercase;letter-spacing:2px;line-height:1;margin:0;filter:drop-shadow(0 15px 20px rgba(0,0,0,.7));opacity:0;transform:scale(2.5) translateZ(300px);animation:pirateTitleSlam .6s 1.2s cubic-bezier(.175,.885,.32,1.275) forwards}
.pirate-intro-subtitle{color:#c0c0c0;font-size:1.3rem;letter-spacing:6px;text-transform:uppercase;margin-top:15px;opacity:0;transform:translateY(20px);animation:pirateFadeUp .8s 2s ease-out forwards}
.pirate-intro-actions{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:40px}
.pirate-intro-actions[hidden]{display:none!important}
.pirate-play-button{position:relative;background:linear-gradient(135deg,#8b0000 0%,#500 100%);color:#ffd700;font-family:"Share Tech Mono",monospace;font-size:1.5rem;font-weight:bold;padding:18px 45px;border:2px solid #ffd700;border-radius:4px;cursor:pointer;text-transform:uppercase;letter-spacing:3px;overflow:hidden;box-shadow:0 0 20px rgba(139,0,0,.6),inset 0 0 15px rgba(255,215,0,.2);opacity:0;transform:translateY(30px);animation:pirateFadeUp .8s 2.6s ease-out forwards;transition:all .3s ease}
.pirate-play-button:before{content:"";position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,215,0,.4),transparent);transition:none}
.pirate-play-button:hover:before{left:100%;transition:left .6s linear}
.pirate-play-button:hover{transform:scale(1.05) translateY(-2px);box-shadow:0 0 35px #ffd700,inset 0 0 10px rgba(255,215,0,.4);color:#fff;border-color:#fff}
.pirate-play-button:active{transform:scale(.98) translateY(1px)}
.pirate-save-panel{width:min(560px,92vw);max-height:calc(100dvh - 34px);margin-top:10px;text-align:center;display:flex;flex-direction:column;min-height:0;animation:pirateSavePanelIn .55s cubic-bezier(.2,.8,.2,1) both}
.pirate-save-panel[hidden]{display:none!important}
.pirate-save-list{display:grid;gap:9px;max-height:min(48vh,420px);min-height:0;overflow-y:auto;overflow-x:hidden;padding:4px;overscroll-behavior:contain}
.pirate-save-item{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border:1px solid #4a6984;background:linear-gradient(110deg,#142433,#0b151e);color:#eee;text-align:left;font:14px "Share Tech Mono",monospace;cursor:pointer;transition:transform .25s,border-color .25s,background .25s;animation:pirateSaveItemIn .4s both}
.pirate-save-item:hover{transform:translateX(7px);border-color:#ffd700;background:#251c18}
.pirate-save-item strong{color:#ffd700;font-weight:700}
.pirate-save-item small{color:#8ca4b8;white-space:nowrap}
.pirate-save-empty{padding:18px;color:#8ca4b8;border:1px dashed #4a6984}
.pirate-play-button.pirate-back-intro{margin-top:13px;animation-delay:0s}
@keyframes pirateOceanPulse{0%{background-position:0 0}100%{background-position:0 100%;filter:hue-rotate(15deg)}}
@keyframes pirateGridFloat{0%{transform:translate(-50%,-50%) rotateX(65deg) rotateZ(0deg) translateZ(-100px)}100%{transform:translate(-50%,-50%) rotateX(65deg) rotateZ(-360deg) translateZ(-100px)}}
@keyframes pirateSymbolFly{0%{transform:translateY(100vh) rotate(0deg) scale(.5);opacity:0}10%{opacity:.4}90%{opacity:.4}100%{transform:translateY(-20vh) rotate(720deg) scale(1.2);opacity:0}}
@keyframes pirateFadeDown{to{opacity:1;transform:translateY(0)}}
@keyframes pirateFadeUp{to{opacity:1;transform:translateY(0)}}
@keyframes pirateTitleSlam{0%{opacity:0;transform:scale(3) translateZ(300px);filter:blur(10px)}70%{opacity:1;transform:scale(.95) translateZ(0);filter:blur(0)}100%{opacity:1;transform:scale(1) translateZ(0);filter:drop-shadow(0 8px 4px rgba(0,0,0,.8))}}
@keyframes pirateSavePanelIn{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:none}}
@keyframes pirateSaveItemIn{from{opacity:0;transform:translateX(-25px)}to{opacity:1;transform:none}}
#pirateGame.pirate-launching .pirate-intro-title-wrap{animation:pirateTitleFly .75s cubic-bezier(.6,0,.8,.2) both}
#pirateGame.pirate-launching .pirate-credits{animation:pirateTitleFly .55s ease-in both}
#pirateGame.pirate-launching .pirate-intro-actions{animation:pirateButtonsScatter .8s cubic-bezier(.7,0,.9,.2) both}
#pirateGame.pirate-launching .pirate-ambient{animation:pirateSeaFlash .8s ease-in both}
@keyframes pirateTitleFly{to{opacity:0;transform:translateY(-120vh) rotateX(70deg) scale(.4);filter:blur(12px)}}
@keyframes pirateButtonsScatter{0%{opacity:1;transform:translateY(0) scale(1)}45%{opacity:1;transform:translateY(15px) scale(.9)}100%{opacity:0;transform:translate(120vw,-30vh) rotate(35deg) scale(.5)}}
@keyframes pirateSeaFlash{50%{filter:brightness(2.2)}100%{opacity:0}}
@media(max-width:700px){.pirate-intro-title{font-size:clamp(3rem,10vw,6.5rem)}.pirate-intro-subtitle{font-size:clamp(.8rem,2vw,1.3rem)}.pirate-play-button{font-size:clamp(1rem,4vw,1.5rem);padding:16px 30px}.pirate-grid-backdrop{width:90vw;height:90vw}}
@media(max-height:600px){.pirate-intro-content{transform:none}}
@media(prefers-reduced-motion:reduce){.pirate-intro *,.pirate-intro *:before{animation-duration:.01ms!important;animation-iteration-count:1!important;transition:none!important}}
/* ---------- Pirate Game ---------- */
#pirateGame{display:none;position:fixed;inset:0;z-index:15;background:#0a1118;color:#eee;overflow:hidden;padding:clamp(8px,1.5vh,18px) clamp(10px,2vw,26px);font-family:"Share Tech Mono","Courier New",monospace}
body.pirate-on #page,body.pirate-on #moreMenu{display:none}
body.pirate-on #pirateGame{display:flex}
.pirate-layout{position:relative;z-index:2;width:min(1180px,100%);height:100%;min-height:0;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(190px,270px);gap:clamp(14px,3vw,38px);align-items:center}
.pirate-board-wrap{width:100%;min-width:0;display:flex;flex-direction:column;justify-content:center;min-height:0}
.pirate-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 clamp(5px,1.5vh,14px)}
.pirate-heading,.pirate-next-label{font-family:"Pirata One","Old English Text MT",Georgia,serif;letter-spacing:1px;text-shadow:0 5px 12px #000b}.pirate-heading{font-size:clamp(30px,5vh,52px);font-weight:400;margin:0;color:#eee;white-space:nowrap}
.pirate-tools{display:flex;gap:6px;align-items:center}
.pirate-icon{width:clamp(32px,4vh,42px);height:clamp(32px,4vh,42px);display:grid;place-items:center;border:1px solid #ffd700;border-radius:3px;background:linear-gradient(135deg,#8b0000,#500);color:#ffd700;font:700 clamp(17px,2.5vh,23px) "Share Tech Mono",monospace;line-height:1;padding:0;box-shadow:0 0 12px #8b000077,inset 0 0 8px #ffd70022;transition:filter .15s,transform .15s}
.pirate-icon:hover{filter:brightness(1.08);transform:translateY(-1px)}
.pirate-side>.pirate-icon{display:grid;margin:0 auto}
.pirate-icon:active{transform:translateY(1px)}
.pirate-icon:disabled{opacity:.38;filter:grayscale(.5);cursor:default;transform:none}
.pirate-board{display:grid;grid-template-columns:clamp(22px,3.4vh,30px) repeat(7,minmax(0,1fr));grid-template-rows:clamp(22px,3.4vh,30px) repeat(7,minmax(0,1fr));width:min(100%,calc(100dvh - 105px));height:min(100%,calc(100dvh - 105px));aspect-ratio:1/1;max-height:calc(100dvh - 105px);margin:0 auto;background:var(--bg);flex:none;touch-action:manipulation}
.pirate-axis{display:grid;place-items:center;font-size:clamp(12px,2.3vh,18px);font-weight:800;color:#fff}
.pirate-square{position:relative;display:block;min-width:0;min-height:0;width:100%;height:100%;border:1px solid #66849a;border-radius:2px;background:linear-gradient(145deg,#142b3b,#0b1924);padding:0;overflow:hidden;appearance:none;-webkit-appearance:none;touch-action:manipulation;transition:background .18s,border-color .18s}
.pirate-square:hover:not(.marked){background:linear-gradient(145deg,#29465a,#142b3b);border-color:#ffd700}
.pirate-square:focus-visible{outline:3px solid #ed244f;outline-offset:-3px;z-index:1}
.pirate-square.marked{cursor:default;background:#0a1118;border-color:#4a6984}
.pirate-cross{position:absolute;inset:8%;width:84%;height:84%;overflow:visible}
.pirate-cross path{fill:none;stroke:#e32636;stroke-width:7;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:120;stroke-dashoffset:120;filter:none}
.pirate-square.just-marked .pirate-cross path{animation:drawPirateCross .42s ease-out forwards}
@keyframes drawPirateCross{to{stroke-dashoffset:0}}
@keyframes piratePlayerIn{from{opacity:0;transform:translateY(12px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.pirate-side{width:100%;align-self:start;min-width:0;padding-top:clamp(4px,1.5vh,16px)}
.pirate-next-label{color:#ffd700;font-size:clamp(28px,4.5vh,42px);font-weight:400;text-decoration:none;margin:0 0 clamp(12px,2.5vh,24px);white-space:normal}
.pirate-turn{font-size:clamp(15px,2.2vh,19px);font-weight:700;line-height:1.3;margin:0 0 12px;min-height:2.6em;color:#c0c0c0}
.pirate-players{display:grid;gap:6px;margin:0 0 12px;padding:0;list-style:none;max-height:30vh;overflow:auto;scrollbar-width:none;overscroll-behavior:contain}.pirate-players::-webkit-scrollbar{display:none;width:0;height:0}
.pirate-player{font-size:clamp(13px,1.9vh,16px);padding:5px 0;border-bottom:1px solid #4a6984;color:#eee;font-weight:500;animation:piratePlayerIn .32s cubic-bezier(.2,.8,.2,1) both}
.pirate-player:first-child{font-weight:800}
.pirate-player{display:flex;align-items:center;justify-content:space-between;gap:8px}
.pirate-player-name{min-width:0;overflow-wrap:anywhere}
.pirate-player-actions{display:flex;align-items:center;gap:5px;flex:none}
.pirate-player-action{display:grid;place-items:center;width:27px;height:27px;padding:4px;border:1px solid #8b6540;border-radius:3px;background:linear-gradient(145deg,#263b4b,#111d28);color:#e9d6a2;cursor:pointer}
.pirate-player-action svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.pirate-player-action:hover{border-color:#ffd700;color:#ffd700}
.pirate-add{display:none;grid-template-columns:minmax(0,1fr) auto;gap:6px;margin:9px 0 10px}
.pirate-add.open{display:grid}
.pirate-add input{grid-column:1/-1;min-width:0;width:100%;height:36px;border:1px solid #66849a;border-radius:3px;background:#101e29;color:#fff;padding:0 10px;font:15px "Share Tech Mono",monospace;outline:none}.pirate-add input:focus{border-color:#ffd700;box-shadow:0 0 10px #ffd70044}
.pirate-add>button[type="submit"]{grid-column:1/-1;height:36px;padding:0 11px;border:1px solid #ffd700;border-radius:3px;background:linear-gradient(135deg,#8b0000,#500);color:#ffd700;font:700 14px "Share Tech Mono",monospace;letter-spacing:1px;text-transform:uppercase;box-shadow:0 0 12px #8b000055,inset 0 0 8px #ffd70022}
.pirate-keyboard{grid-column:1/-1;display:grid;gap:5px;margin-top:3px;user-select:none;touch-action:manipulation}
.pirate-key-row{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:4px}
